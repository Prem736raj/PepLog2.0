<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for PepLog.

    - Cleartext (HTTP) traffic is disabled — all network requests must use HTTPS.
    - Only system-trusted CAs are used (no custom certificates).
    - Debug builds additionally trust user-installed certificates for
      proxy inspection tools (e.g. Charles Proxy, mitmproxy).
-->
<network-security-config>
    <!-- Production: HTTPS only, system CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug: Also trust user-installed certificates for proxy tools -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
