# =============================================================================
# PepLog Release Keystore Configuration
# =============================================================================
#
# Copy this file to `keystore.properties` (in the project root) and fill in
# your actual values. NEVER commit `keystore.properties` to version control.
#
# To generate a release keystore:
#   keytool -genkeypair -v -keystore peplog-release.jks -alias peplog \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# To get the SHA-256 certificate hash:
#   keytool -list -v -keystore peplog-release.jks -alias peplog \
#           | grep SHA256
#   (Copy the hash, including colons, e.g. AA:BB:CC:DD:...)
#
# To get your Google Cloud project number:
#   Go to https://console.cloud.google.com → Select your project →
#   Dashboard → Project number (numeric)
# =============================================================================

# Release keystore path (relative to project root or absolute)
storeFile=peplog-release.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=peplog

# Key password
keyPassword=YOUR_KEY_PASSWORD

# SHA-256 hash of your release signing certificate (with colons)
# Example: AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90
RELEASE_CERT_HASH=

# Google Cloud project number for Play Integrity API
# Get this from https://console.cloud.google.com → Dashboard
CLOUD_PROJECT_NUMBER=0
